<resources>
    <style name="Theme.FixIt" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/fixit_primary</item>
        <item name="colorPrimaryDark">@color/fixit_primary_dark</item>
        <item name="colorAccent">@color/fixit_accent</item>
    </style>

    <!-- Shared look used by every screen -->
    <style name="Widget.FixIt.TitleBar" parent="">
        <item name="android:background">@color/fixit_primary</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.FixIt.Card" parent="">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="Widget.FixIt.Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/fixit_text</item>
        <item name="android:textColorHint">@color/fixit_text_secondary</item>
    </style>

    <style name="Widget.FixIt.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/fixit_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.FixIt.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/fixit_primary</item>
        <item name="android:textColor">@color/fixit_primary</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.FixIt.Button.Back" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/fixit_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minWidth">140dp</item>
        <item name="cornerRadius">50dp</item>
    </style>
</resources>
