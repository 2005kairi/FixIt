<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.FixIt"
        android:supportsRtl="true">

        <!-- Person 1: Login & Signup -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SignupActivity" android:exported="false" />

        <!-- Person 3: Tenant side -->
        <activity android:name=".TenantHomeActivity" android:exported="false" />
        <activity android:name=".NewRequestActivity" android:exported="false" />

        <!-- Person 4: Landlord side -->
        <activity android:name=".LandlordHomeActivity" android:exported="false" />
        <activity android:name=".RequestDetailActivity" android:exported="false" />

        <!-- Person 5: Broadcast receiver for new maintenance requests -->
        <receiver
            android:name=".NewRequestReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.fixit.app.NEW_REQUEST" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
